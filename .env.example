# Which LLM adapter to use: "anthropic" (real answers) or "mock" (offline, deterministic; used by tests/CI)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low effort keeps short RAG answers fast and cheap
LLM_EFFORT=low

# USD per million tokens, used for the estimated_cost column in the log DB
INPUT_COST_PER_MTOK=4.0
OUTPUT_COST_PER_MTOK=20.0

RETRIEVAL_TOP_K=4

# Simulate order-tool problems for failure-recovery tests: none | timeout | error
TOOL_FAILURE_MODE=none
TOOL_TIMEOUT_SECONDS=2.0

DB_PATH=docuchat.db

# Optional: require this key in the X-API-Key header for POST /chat (leave empty for local use)
API_KEY=
